@* VotePage.razor *@
@page "/vote/{playlistId}/{SessionId}"
@layout MainLayout
@using BeatBallot.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@implements IAsyncDisposable
@inject IPlaylistVoteCacheService PlaylistVoteCacheService
@inject ISessionActivityLogger SessionActivityLogger

<div class="vote-container">
    <HeaderComponent />
    
    @*     <NowPlayingComponent CurrentSong="@currentSong.SongName"
                        CurrentArtist="@currentSong.Artist"
                        />
     *@
    <VotingSectionComponent Songs="@_availableSongs"
                            VotesRemaining="@_userVotesRemaining"
                            OnVote="@HandleVote"
                            IsDisabled="@_isVotingStopped" 

    />
    
    <VotingStoppedNotificationComponent IsVisible="@_showVotingStoppedMessage" 
                               OnAcknowledge="@HandleVotingStoppedAcknowledged" />

</div>






@if (_showSuccessMessage)
{
    <div class="success-message">
        @_successMessageText
    </div>
}

@code {
    [Parameter] public string SessionId { get; set; } = "";

    [Parameter] public string PlaylistId { get; set; } = "";
    
    private HubConnection? _hubConnection;
    private int _userVotesRemaining = 50;
    private bool _showSuccessMessage = false;
    private string _successMessageText = "";
    private bool _showVotingStoppedMessage;
    private bool _isVotingStopped;

    private SongVoteInfo _currentSong = new SongVoteInfo();
    private List<SongVoteInfo> _availableSongs;


    protected override async Task OnInitializedAsync()
    {
        // Validate session ID
        if (string.IsNullOrEmpty(SessionId) || string.IsNullOrEmpty(PlaylistId))
        {
            // Redirect to error page or show invalid session message
            return;
        }

        await LoadSessionData();
        await ConfigureNotification();
    }

    private async Task LoadSessionData()
    {
        _availableSongs = await PlaylistVoteCacheService.GetSongList(PlaylistId, SessionId);
    }


    private async Task ConfigureNotification()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/votingHub"))
            .Build();
        
        await _hubConnection.StartAsync();
        
        // Join the specific DJ session group
        await _hubConnection.SendAsync("JoinPlaylistGroup", PlaylistId, SessionId);
        
        // Listen for session-specific updates
        _hubConnection.On<string, int>("VoteCountUpdated", VoteCountUpdatedHandler);
        _hubConnection.On("NotifyVotingStopped", NotifyVotingStoppedHandler);
    }


    private async Task NotifyVotingStoppedHandler()
    {
        await HandleVotingStopped();
    }

    private async Task HandleVotingStopped()
    {
        await InvokeAsync(() =>
        {
            _isVotingStopped = true;
            _showVotingStoppedMessage = true;
            StateHasChanged();
        });
    }

    private async Task VoteCountUpdatedHandler(string songId, int newVoteCount)
    {
        var song = _availableSongs.FirstOrDefault(s => s.SongId == songId);
        if (song != null)
        {
            song.VoteCount = newVoteCount;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleVotingStoppedAcknowledged()
    {
        _showVotingStoppedMessage = false;
        StateHasChanged();
    }

    private async Task HandleVote(SongVoteInfo song)
    {

        if (_userVotesRemaining > 0)
        {
            // Find the song in our list and update it
            var songToUpdate = _availableSongs.FirstOrDefault(s => s.SongId == song.SongId);
            if (songToUpdate != null)
            {
                _userVotesRemaining--;
                VoteRequest voteREquest = new VoteRequest();
                voteREquest.SongId = songToUpdate.SongId;
                voteREquest.SessionId = SessionId;
                voteREquest.PlaylistId = PlaylistId;

                // Send vote update to specific session group
                if (_hubConnection is not null)
                {
                    await _hubConnection.SendAsync("CastVote", voteREquest);
                }
                
                StateHasChanged();
            }
        }
    }

    private async Task UpdateCurrentSong(string title, string artist)
    {
        _currentSong.SongName = title;
        _currentSong.Artist = artist;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdatePlayPause(bool isPlaying)
    {
        // Update UI to reflect play/pause state
        await InvokeAsync(StateHasChanged);
    }


    private async Task UpdateListenerCount(int count)
    {
        
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            // Leave the session group before disposing
            await _hubConnection.SendAsync("LeaveSession", SessionId);
            await _hubConnection.DisposeAsync();
        }
    }

    public class CurrentSongModel
    {
        public string Title { get; set; } = "";
        public string Artist { get; set; } = "";
        public string CurrentTime { get; set; } = "";
        public string TotalTime { get; set; } = "";
        public double ProgressPercentage { get; set; }
    }
}
