@* QRDisplayComponent.razor *@
@page "/qr/{SessionId}"
@layout MainLayout
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
@using QRCoder

@if (!_showRequestsStoppedMessage)
{
    <div class="qr-display-page">
        <div class="qr-container">
            <div class="logo-section">
                <div class="logo"><img src="header-icon-small.png" /></div>
                <div class="logo-subtitle"><img src="image 2.png"/></div>
            </div>
            <div class="header-section">
                <div class="logo">Taking Requests!</div>
                
            </div>

            <div class="qr-section">
                <div class="qr-code-display">
                    <img src="@_qrCodeImage" alt="" />
                </div>

       @*          <div class="voting-url-display">
                    <div class="url-text">@GetTakingRequestsUrl()</div>
                </div> *@
            </div>
@* 
            <div class="instructions-section">
                <div class="instruction-step">
                    <div class="step-number">1</div>
                    <div class="step-text">Open your phone's camera</div>
                </div>
                <div class="instruction-step">
                    <div class="step-number">2</div>
                    <div class="step-text">Point at the QR code above</div>
                </div>
                <div class="instruction-step">
                    <div class="step-number">3</div>
                    <div class="step-text">Tap the notification to start requesting songs.</div>
                </div>
            </div>
      *@
@*             <div class="live-indicator">
                <div class="live-dot"></div>
                <span class="live-text">TAKING LIVE REQUESTS</span>
            </div>
 *@
    @*         <div class="session-info">
                <div class="session-label">Session ID</div>
                <div class="session-code">@SessionId.Substring(0, 12)...</div>
            </div> *@
        </div>
    </div>

}
else
{
    <VotingStoppedNotificationComponent IsVisible="@_showRequestsStoppedMessage" ShowAcknowledgeButton="false" />
}




@code {
    [Parameter] public string SessionId { get; set; } = "";

    [Parameter] public string PlaylistId { get; set; } = "";

    private string _qrCodeImage;
    


    private HubConnection? _hubConnection;

    private bool _showRequestsStoppedMessage;
    private bool _isTakingRequestsStopped;


    protected override async Task OnInitializedAsync()
    {

        // Validate session ID
        if (string.IsNullOrEmpty(SessionId))
        {
            Navigation.NavigateTo("/");
            return;
        }
        using QRCodeGenerator qrGenerator = new QRCodeGenerator();
        QRCodeData qrCodeData = qrGenerator.CreateQrCode(GetTakingRequestsUrl(), QRCodeGenerator.ECCLevel.Q);
        Base64QRCode qrCode = new Base64QRCode(qrCodeData);
        _qrCodeImage = $"data:image/png;base64,{qrCode.GetGraphic(10)}";

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/songRequestHub"))
            .Build();
        
        await _hubConnection.StartAsync();
        await _hubConnection.SendAsync("JoinListenerSession", SessionId);
        // Listen for session stopped notifications
        _hubConnection.On<object>("RequestsStopped", async (data) =>
        {
            await InvokeAsync(() =>
            {
                _isTakingRequestsStopped = true;
                _showRequestsStoppedMessage = true;
                StateHasChanged();
            });
        });
    }

    private string GetTakingRequestsUrl()
    {
        var baseUrl = Navigation.BaseUri.TrimEnd('/');
        return $"{baseUrl}/request/{SessionId}";
    }
}
