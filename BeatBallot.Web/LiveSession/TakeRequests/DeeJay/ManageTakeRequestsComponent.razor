                    </p>
                </div>

                <div class="modal-actions">
                    <button class="cancel-btn" @onclick="CancelStop">
                        <span>Cancel</span>
                    </button>
                    <button class="confirm-btn stop" @onclick="ConfirmStop">
                        <span>Stop Taking Requests</span>
                    </button>
                </div>
            </div>
