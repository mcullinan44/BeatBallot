@* ManageLiveComponent.razor *@
@page "/dj/session/{SessionId}/manage"

@layout DJLayoutComponent
@using System.Runtime.CompilerServices
@using System.Text.Json
@using BeatBallot.Web.Home.DeeJay
@using BeatBallot.Web.Services
@using BeatBallot.Web.Services.Local
@using BeatBallot.Web.Services.Local.BeatBallot.Web.Services.Local
@using BeatBallot.Web.Services.Spotify
@using Microsoft.AspNetCore.SignalR.Client
@using SpotifyAPI.Web
@using Swan
@inject NavigationManager Navigation
@inject SpotifyService SpotifyService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ITokenProvider TokenProvider
@inject ISongRequestCacheService SongRequestCacheService
@inject ISessionActivityLogger SessionActivityLogger
@inject ITipService TipService

@inject IJSRuntime JSRuntime

@implements IAsyncDisposable

<div class="manage-live-page">
    <div class="page-header">
        <div class="header-content">

            <div class="session-info">
                <h1 class="page-title">Managing Live Session</h1>
                <div class="session-details">
                    <div class="playlist-name">
                        <span class="label">Taking Requests</span>
                    </div>
                    <div class="session-start">
                        <span class="label">Started:</span>
                        <span class="value">@_sessionStartTime.ToString("MMM dd, yyyy h:mm tt")</span>
                    </div>
                    <div class="session-duration">
                        <span class="label">Duration:</span>
                        <span class="value" id="duration-display">@GetSessionDuration()</span>
                    </div>
                    <div class="listener-count">
                        <span class="label">Active Listeners:</span>
                        <span class="value">@_activeListeners</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-actions">
            @if (!_isSessionOver)
            {
                <button class="stop-btn" @onclick="ShowStopConfirmation">
                    <span class="btn-icon">⏹️</span>
                    <span>Stop Taking Requests</span>
                </button>

            }
        </div>
    </div>
    
<!-- QR Code Section for Request URL -->
<div class="qr-code-section">
    <div class="qr-info">
        <h3 class="qr-title">Audience Setup</h3>
        <p class="qr-description">Share this URL so your listeners can request songs. Display the QR code for easy access.</p>
        <div class="voting-url">

            @if (_isSessionOver)
            {
                <span class="voting-link">Session Ended</span>
            }
            else
            {
                <span class="url-label">Request URL:</span>
                <a href="@GetRequestUrl()" target="_blank" class="voting-link">@GetRequestUrl()</a>
                <button class="copy-btn" @onclick="CopyRequestUrl" title="Copy URL">
                    <span class="copy-icon">📋</span>
                </button>
            }

        </div>
        <div class="voting-url">
            @if (_isSessionOver)
            {
                <span class="voting-link">Session Ended</span>
            }
            else
            {
                <span class="url-label">QR Display URL:</span>
                <a href="@GetQrDisplayUrl()" target="_blank" class="voting-link">@GetQrDisplayUrl()</a>
                <button class="copy-btn" @onclick="CopyQrDisplayUrl" title="Copy URL">
                    <span class="copy-icon">📋</span>
                </button>
            }

        </div>
    </div>

</div>

<!-- Session Policy Controls -->
    @if (!_isSessionOver)
    {
        <div class="session-policy-section">
            <div class="policy-header">
                <h3 class="policy-title">Session Policies</h3>
                <p class="policy-description">Configure what content listeners can request and how they interact with your session</p>
            </div>

            <div class="policy-controls">
                <!-- Content Filtering -->
                <div class="policy-group">
                    <h4 class="policy-group-title">Content Filtering</h4>

                    <div class="policy-control-item">
                        <label class="policy-toggle">
                            <input type="checkbox"
                                   @bind="_sessionPolicy.BlockExplicitContent"
                                   @bind:after="OnPolicyChanged"
                                   class="toggle-input" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">
                                <span class="toggle-text">Block Explicit Content</span>
                                <span class="toggle-description">
                                    @if (_sessionPolicy.BlockExplicitContent)
                                    {
                                        <span class="policy-status active">🚫 Explicit songs hidden from listeners</span>
                                    }
                                    else
                                    {
                                        <span class="policy-status inactive">⚠️ Explicit songs allowed</span>
                                    }
                                </span>
                            </span>
                        </label>
                    </div>

                     <div class="policy-control-item">
                        <label class="input-label">Minimum Song Duration (minutes)</label>
                        <div class="input-group">
                            <input type="number"
                                   @bind="_minDurationMinutes"
                                   @bind:after="OnDurationPolicyChanged"
                                   min="0"
                                   max="30"
                                   step="0.5"
                                   class="policy-input"
                                   placeholder="No minimum" />
                            <span class="input-suffix">min</span>
                        </div>
                    </div>

                    <div class="policy-control-item">
                        <label class="input-label">Maximum Song Duration (minutes)</label>
                        <div class="input-group">
                            <input type="number"
                                   @bind="_maxDurationMinutes"
                                   @bind:after="OnDurationPolicyChanged"
                                   min="1"
                                   max="60"
                                   step="0.5"
                                   class="policy-input"
                                   placeholder="No maximum" />
                            <span class="input-suffix">min</span>
                        </div>
                    </div> 
                </div>

                <!-- Request Limits -->
                 <div class="policy-group">
                    <h4 class="policy-group-title">Request Limits</h4>

                    <div class="policy-control-item">
                        <label class="input-label">Max Requests Per Listener</label>
                        <div class="input-group">
                            <input type="number"
                                   @bind="_sessionPolicy.MaxRequestsPerListener"
                                   @bind:after="OnPolicyChanged"
                                   min="1"
                                   max="50"
                                   class="policy-input"
                                   placeholder="Unlimited" />
                            <span class="input-suffix">requests</span>
                        </div>
                    </div>

