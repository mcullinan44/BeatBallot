        _djUserName = t.DisplayName;
        _djEmail = t.Email;

        // Load existing session policy if it exists, otherwise create default
        var existingPolicy = await SongRequestCacheService.GetSessionPolicyAsync(SessionId);
        if (existingPolicy != null)
        {
            _originalSessionPolicy = existingPolicy;
        }
        else
        {
            // Store original policy for revert functionality
            _originalSessionPolicy = new SessionPolicy
            {
                SessionId = SessionId,
                BlockExplicitContent = _sessionPolicy.BlockExplicitContent,
                MaxRequestsPerListener = _sessionPolicy.MaxRequestsPerListener,
                MinSongDurationMs = _sessionPolicy.MinSongDurationMs,
                MaxSongDurationMs = _sessionPolicy.MaxSongDurationMs,
                BlockedArtists = new List<string>(_sessionPolicy.BlockedArtists),
                BlockedGenres = new List<string>(_sessionPolicy.BlockedGenres),
                AllowDuplicateRequests = _sessionPolicy.AllowDuplicateRequests,
                ShowRequestsToListeners = _sessionPolicy.ShowRequestsToListeners,
                PolicyMessage = _sessionPolicy.PolicyMessage,
