                <div class="modal-actions">
                    <button class="cancel-btn" @onclick="CancelClearAll">
                        <span>Cancel</span>
                    </button>
                    <button class="confirm-btn clear" @onclick="ConfirmClearAll">
                        <span>Clear All Requests</span>
                    </button>
                </div>
            </div>
        </div>
