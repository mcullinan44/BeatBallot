        _maxDurationMinutes = _sessionPolicy.MaxSongDurationMs.HasValue ? _sessionPolicy.MaxSongDurationMs.Value / 60000.0 : null;
        await LoadTipData(); // Add this line
        await InitializeSignalRConnection();
        await LoadRequestsData();

        SessionActivityLogger.LogSessionCreated(SessionId, _djUserName);
        StartDurationTimer();
    }

    private async Task InitializeSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/songRequestHub"))
                .Build();

            // Handle new song requests
            _hubConnection.On<object>("NewSongRequests", async (data) =>
            {
                await InvokeAsync(async () =>
                {

                    var dataJson = System.Text.Json.JsonSerializer.Serialize(data);


                    // Parse dynamically using System.Text.Json
                    using JsonDocument doc = JsonDocument.Parse(dataJson);
                    JsonElement root = doc.RootElement;

                    // Extract session info
                    string sessionId = root.GetProperty("sessionId").GetString();
                    int songsAdded = root.GetProperty("songsAdded").GetInt32();

                    // Process new songs
                    if (root.TryGetProperty("newSongs", out JsonElement newSongsElement))
                    {
                        foreach (JsonElement songElement in newSongsElement.EnumerateArray())
                        {
                            string trackId = songElement.GetProperty("trackId").GetString();
                            string trackName = songElement.GetProperty("trackName").GetString();
                            string artists = songElement.GetProperty("artists").GetString();
                            string album = songElement.GetProperty("album").GetString();
                            int duration = songElement.GetProperty("duration").GetInt32();
                            DateTime requestedAt = songElement.GetProperty("requestedAt").GetDateTime();
                            string requesterName = songElement.GetProperty("requesterName").GetString();
                            string deviceId = songElement.GetProperty("requesterName").GetString();

                            // Log the song request
                            SessionActivityLogger.LogSongRequested(
                                sessionId,
                                trackName,
                                artists, requesterName, deviceId);




                        }
                    }



                    await LoadRequestsData();
                    
                    // Update auto-play queue if enabled
                    if (_isAutoPlayEnabled)
                    {
                        UpdateNextSongInQueue();
                    }
                    
                    StateHasChanged();
                });
            });

            // Handle listener count updates
            _hubConnection.On<object>("ListenerCountUpdate", async (data) =>
            {
                await InvokeAsync(() =>
                {


                    try
                    {
                        var dataJson = System.Text.Json.JsonSerializer.Serialize(data);
                        var options = new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        };
                        var updateData = System.Text.Json.JsonSerializer.Deserialize<ListenerCountUpdate>(dataJson, options);
                        var newCount = updateData?.ListenerCount ?? 0;
                        if (newCount > _activeListeners)
                        {
                            // Someone joined
                            //SessionActivityLogger.LogSessionJoined(SessionId, "Anonymous Listener");
                        }
                        else if (newCount < _activeListeners)
                        {
                            // Someone left
                            SessionActivityLogger.LogSessionLeft(SessionId, "Anonymous Listener");
                        }

                        _activeListeners = updateData?.ListenerCount ?? 0;

                        StateHasChanged();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error parsing listener count update: {ex.Message}");
                    }
                });
            });

            await _hubConnection.StartAsync();
            PrivateUser user = await SpotifyService.GetUser();
            // Join as DJ and set initial policy
            await _hubConnection.SendAsync("StartTakeRequestsSession", SessionId, user, _originalSessionPolicy);

            // Send the current session policy to all listeners
            await _hubConnection.SendAsync("UpdateSessionPolicy", SessionId, _originalSessionPolicy);



            _hubConnection.On<Tip>("NewTip", async (tip) =>
            {
                await InvokeAsync(async () =>
                {
                    // Add to recent tips
                    _recentTips.Insert(0, tip);
            
                    // Mark as new for animation
                    _newTipIds.Add(tip.Id);
            
                    // Update total
                    _totalTipsReceived += tip.Amount;
            
                    // Log the tip received
                    SessionActivityLogger.LogTipReceived(SessionId, tip.TipperName, tip.Amount, _djUserName);
            
                    // Show notification
                    _statusMessage = $"🎉 New tip received: ${tip.Amount:F2} from {tip.TipperName}!";
            
                    StateHasChanged();
            
                    // Remove new indicator after animation
                    _ = Task.Delay(3000).ContinueWith(_ =>
                    {
                        _newTipIds.Remove(tip.Id);
                        _statusMessage = "";
                        InvokeAsync(StateHasChanged);
                    });
                });
            });


        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing SignalR: {ex.Message}");
        }
    }

    private async Task LoadRequestsData()
    {
        try
        {
            _isLoading = true;

            // Get grouped song requests from cache service
            var groupedSongs = await SongRequestCacheService.GetSessionSongsGroupedAsync(SessionId);

            // Extract the songs and update statistics
            _requestedSongs = groupedSongs.Select(g => g.Song).ToList();
            _totalRequests = groupedSongs.Sum(g => g.RequestCount);
            _totalUniqueRequests = groupedSongs.Count;

            // Store grouped data for easy access to request counts and metadata
            _songRequestGroups = groupedSongs;

            // Initialize custom order if not set or if new songs were added
            if (!_customOrderSongs.Any() || _customOrderSongs.Count != _requestedSongs.Count)
            {
                _customOrderSongs = new List<FullTrack>(_requestedSongs);
            }
            else
            {
                // Update custom order to include any new songs while preserving existing order
                var newSongs = _requestedSongs.Where(s => !_customOrderSongs.Any(cs => cs.Id == s.Id)).ToList();
                _customOrderSongs.AddRange(newSongs);

                // Remove songs that are no longer in the requests
                _customOrderSongs = _customOrderSongs.Where(cs => _requestedSongs.Any(s => s.Id == cs.Id)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading requests: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshRequests()
    {
        await LoadRequestsData();
        
        // Update auto-play queue if enabled
        if (_isAutoPlayEnabled)
        {
            UpdateNextSongInQueue();
        }
    }

    private IEnumerable<FullTrack> GetDisplaySongs()
    {
        return _currentSortMode switch
        {
            SortMode.MostRecent => _requestedSongs.OrderByDescending(s => GetLatestRequestTime(s.Id)),
            SortMode.Oldest => _requestedSongs.OrderBy(s => GetFirstRequestTime(s.Id)),
            SortMode.MostRequested => _requestedSongs
                .OrderByDescending(s => GetRequestCount(s.Id))
                .ThenByDescending(s => GetLatestRequestTime(s.Id)),
            SortMode.Custom => _customOrderSongs.Where(s => _requestedSongs.Any(r => r.Id == s.Id)),
            _ => _requestedSongs
        };
    }

    private async Task OnSortModeChanged()
    {
        // Reset custom order when switching from custom mode
        if (_currentSortMode != SortMode.Custom)
        {
            _customOrderSongs = new List<FullTrack>(GetDisplaySongs());
        }

        // Update auto-play indices when sort order changes
        if (_isAutoPlayEnabled)
        {
            var displaySongs = GetDisplaySongs().ToList();
            if (!string.IsNullOrEmpty(_currentlyPlayingSongId))
            {
                var currentSongIndex = displaySongs.FindIndex(s => s.Uri == _currentlyPlayingSongId);
                _currentAutoPlayIndex = currentSongIndex >= 0 ? currentSongIndex : 0;
            }
            UpdateNextSongInQueue();
        }

        StateHasChanged();
    }

    private int GetRequestCount(string songId)
    {
        return _songRequestGroups.FirstOrDefault(g => g.Song.Id == songId)?.RequestCount ?? 0;
    }

    private DateTime GetFirstRequestTime(string songId)
    {
        return _songRequestGroups.FirstOrDefault(g => g.Song.Id == songId)?.FirstRequestedAt ?? DateTime.MinValue;
    }

    private DateTime GetLatestRequestTime(string songId)
    {
        return _songRequestGroups.FirstOrDefault(g => g.Song.Id == songId)?.LatestRequestedAt ?? DateTime.MinValue;
    }

    private List<string> GetRequesters(string songId)
    {
        return _songRequestGroups.FirstOrDefault(g => g.Song.Id == songId)?.RequesterNames ?? new List<string>();
    }

    // Replace your existing drag and drop methods with these fixed versions

    private void OnDragStart(int index)
    {
        if (_currentSortMode != SortMode.Custom) return;

        _draggedIndex = index;
        _dragTargetIndex = -1;
    }

    private void OnDragEnter(int index)
    {
        if (_currentSortMode != SortMode.Custom || _draggedIndex < 0 || _draggedIndex == index) return;

        _dragTargetIndex = index;

    }

    private void OnDragOver(int index)
    {
        // This prevents the default behavior and allows the drop
        if (_currentSortMode == SortMode.Custom && _draggedIndex >= 0)
        {
            _dragTargetIndex = index;
        }
    }

    private void OnDragLeave(int index)
    {
        // Only clear if we're actually leaving this specific target
        if (_dragTargetIndex == index)
        {
            _dragTargetIndex = -1;
        }
    }

    private void OnDrop(int targetIndex)
    {
        if (_currentSortMode != SortMode.Custom || _draggedIndex < 0 || _draggedIndex == targetIndex)
        {
            ResetDragState();
            return;
        }

        try
        {
            var displaySongs = GetDisplaySongs().ToList();

            if (_draggedIndex >= 0 && _draggedIndex < displaySongs.Count &&
                targetIndex >= 0 && targetIndex < displaySongs.Count)
            {
                var draggedSong = displaySongs[_draggedIndex];
                // Create a new list for the custom order
                var newCustomOrder = new List<FullTrack>(_customOrderSongs);
                // Remove the dragged item
                newCustomOrder.Remove(draggedSong);
                // Insert at the new position
                var insertIndex = Math.Min(targetIndex, newCustomOrder.Count);
                newCustomOrder.Insert(insertIndex, draggedSong);
                // Update the custom order
                _customOrderSongs = newCustomOrder;

                // Update auto-play index if needed
                if (_isAutoPlayEnabled && !string.IsNullOrEmpty(_currentlyPlayingSongId))
                {
                    var newDisplaySongs = GetDisplaySongs().ToList();
                    var currentSongIndex = newDisplaySongs.FindIndex(s => s.Uri == _currentlyPlayingSongId);
                    _currentAutoPlayIndex = currentSongIndex >= 0 ? currentSongIndex : 0;
                    UpdateNextSongInQueue();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during drop: {ex.Message}");
        }
        finally
        {
            ResetDragState();
            StateHasChanged();
        }
    }

    private void ResetDragState()
    {
        _draggedIndex = -1;
        _dragTargetIndex = -1;
    }


    private async Task PlaySong(string spotifyUri, int? songIndex = null)
    {
        try
        {
            _currentlyPlayingSongId = spotifyUri;
            _isPlaying = true;

            // Update auto-play index if provided
            if (_isAutoPlayEnabled && songIndex.HasValue)
            {
                _currentAutoPlayIndex = songIndex.Value;
                UpdateNextSongInQueue();
            }

            var result = await SpotifyService.PlaySongWithDeviceCheckAsync(spotifyUri);

            var song = _requestedSongs.FirstOrDefault(s => s.Uri == spotifyUri);
            if (song != null)
            {
                // Log the song being played
                SessionActivityLogger.LogSongPlayed(
                    SessionId,
                    song.Name,
                    string.Join(", ", song.Artists.Select(a => a.Name)),
                    _djUserName // Replace with actual DJ name
                );

                // Set up monitoring for auto-play
                if (_isAutoPlayEnabled)
                {
                    _currentSongStartTime = DateTime.Now;
                    _currentSongDurationMs = song.DurationMs;
                }
            }


            if (result.Success)
            {
                if (!string.IsNullOrEmpty(result.ActivatedDevice))
                {
                    _statusMessage = $"Activated {result.ActivatedDevice} and started playing";
                    // Clear message after 3 seconds
                    _ = Task.Delay(3000).ContinueWith(_ =>
                    {
                        _statusMessage = "";
                        InvokeAsync(StateHasChanged);
                    });
                }
            }
            else
            {
                _currentlyPlayingSongId = "";
                _isPlaying = false;

                if (result.RequiresUserAction)
                {
                    await ShowDeviceSelector();
                }
                else
                {
                    _statusMessage = result.Message;
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            SessionActivityLogger.LogError(SessionId, ex.Message, ex);
            _currentlyPlayingSongId = "";
            _isPlaying = false;
            _statusMessage = $"Failed to play song: {ex.Message}";
            Console.WriteLine($"Failed to play song: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task PauseSong()
    {
        try
        {
            var result = await SpotifyService.PausePlaybackWithDeviceCheckAsync();
            _isPlaying = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to pause: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ResumeSong()
    {
        try
        {
            var result = await SpotifyService.ResumePlaybackWithDeviceCheckAsync();

            if (result.Success)
            {
                _isPlaying = true;

                if (!string.IsNullOrEmpty(result.ActivatedDevice))
                {
                    _statusMessage = $"Activated {result.ActivatedDevice} and resumed playback";
                    _ = Task.Delay(3000).ContinueWith(_ =>
                    {
                        _statusMessage = "";
                        InvokeAsync(StateHasChanged);
                    });
                }
            }
            else
            {
                if (result.RequiresUserAction)
                {
                    await ShowDeviceSelector();
                }

            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to resume: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ShowDeviceSelector()
    {
        var deviceResponse = await SpotifyService.GetAvailableDevicesAsync();

        if (deviceResponse.Success && deviceResponse.Devices.Any())
        {
            _availableDevices = deviceResponse.Devices;
            _showDeviceSelector = true;
        }
        else
        {
            _statusMessage = "No Spotify devices found. Please open Spotify on a device (desktop, mobile, or web player) and try again.";
        }
    }

    private async Task SelectDevice(string deviceId)
    {
        var success = await SpotifyService.ActivateDeviceAsync(deviceId);

        if (success)
        {
            var deviceName = _availableDevices.FirstOrDefault(d => d.Id == deviceId)?.Name ?? "device";
            _statusMessage = $"Activated {deviceName}. You can now play music.";
            _showDeviceSelector = false;

            // Clear message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                _statusMessage = "";
                InvokeAsync(StateHasChanged);
            });
        }
        else
        {
            _statusMessage = "Failed to activate device. Please try again.";
        }

        StateHasChanged();
    }

    private void CancelDeviceSelector()
    {
        _showDeviceSelector = false;
        StateHasChanged();
    }

    private async Task RemoveSongRequest(string songId)
    {
        try
        {
            // Remove from cache service first
            var result = await SongRequestCacheService.RemoveSongRequestAsync(SessionId, songId);

            if (result.Success)
            {
                // Remove from local lists
                _requestedSongs.RemoveAll(s => s.Id == songId);
                _customOrderSongs.RemoveAll(s => s.Id == songId);
                _songRequestGroups.RemoveAll(g => g.Song.Id == songId);

                // Update statistics
                _totalRequests = _songRequestGroups.Sum(g => g.RequestCount);
                _totalUniqueRequests = _songRequestGroups.Count;

                // Update auto-play indices if needed
                if (_isAutoPlayEnabled)
                {
                    var displaySongs = GetDisplaySongs().ToList();
                    if (!string.IsNullOrEmpty(_currentlyPlayingSongId))
                    {
                        var currentSongIndex = displaySongs.FindIndex(s => s.Uri == _currentlyPlayingSongId);
                        _currentAutoPlayIndex = currentSongIndex >= 0 ? currentSongIndex : Math.Max(0, _currentAutoPlayIndex - 1);
                    }
                    UpdateNextSongInQueue();
                }

                StateHasChanged();
            }
            else
            {
                Console.WriteLine($"Failed to remove song request: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing song request: {ex.Message}");
        }
    }

