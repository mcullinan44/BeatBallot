    }

    <!-- Add this status message section after your page-header -->
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="status-message">
            <div class="status-content">
                <button class="status-close" @onclick="ClearStatusMessage">&times;</button>
                <span class="status-icon">ℹ️</span>
                <span class="status-text">@_statusMessage</span>
            </div>
        </div>
    }



    <!-- Live Stats -->
    <div class="live-stats">
        <div class="stat-card">
            @* <div class="stat-icon">🎵</div> *@
            <div class="stat-content">
                <div class="stat-number">@_totalUniqueRequests</div>
                <div class="stat-label">Unique Songs</div>
            </div>
        </div>
        <div class="stat-card">
            @* <div class="stat-icon">📊</div> *@
            <div class="stat-content">
                <div class="stat-number">@_totalRequests</div>
                <div class="stat-label">Total Requests</div>
            </div>
        </div>
        @* <div class="stat-card">
             <div class="stat-icon">👥</div> 
            <div class="stat-content">
                <div class="stat-number">@_activeListeners</div>
                <div class="stat-label">Active Listeners</div>
            </div>
        </div> *@
        <div class="stat-card">
            @* <div class="stat-icon">⏱️</div> *@
            <div class="stat-content">
                <div class="stat-number">@GetSessionDuration()</div>
                <div class="stat-label">Session Time</div>
            </div>
        </div>
    </div>
    
    
    <!-- Tip Dashboard -->
@if (_totalTipsReceived > 0)
{
    <div class="tips-dashboard">
        <div class="tips-header">
            <h3 class="tips-title">💰 Tips Received</h3>
            <div class="tips-total">
                <span class="tips-amount">$@_totalTipsReceived.ToString("F2")</span>
                <span class="tips-label">Total this session</span>
            </div>
        </div>

        @if (_recentTips.Any())
        {
            <div class="recent-tips-grid">
                @foreach (var tip in _recentTips.Take(5))
                {
                    <div class="tip-notification @(_newTipIds.Contains(tip.Id) ? "new-tip" : "")">
                        <div class="tip-header">
                            <span class="tip-amount">$@tip.Amount.ToString("F2")</span>
                            <span class="tip-time">@tip.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="tip-content">
                            <span class="tipper-name">@tip.TipperName</span>
                            @if (!string.IsNullOrEmpty(tip.Message))
                            {
                                <div class="tip-message">"@tip.Message"</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="tips-actions">
            <button class="control-btn tips-settings-btn" @onclick="ShowTipSettings">
                <span class="btn-icon">⚙️</span>
                <span>Tip Settings</span>
            </button>
            <button class="control-btn view-all-tips-btn" @onclick="ViewAllTips">
                <span class="btn-icon">📊</span>
                <span>View All Tips</span>
            </button>
        </div>
    </div>
}
else if (_djPaymentSettings?.IsPaymentEnabled == true)
{
    <div class="tips-dashboard">
        <div class="no-tips-yet">
            <div class="no-tips-icon">💰</div>
            <h3>Tip Jar is Active</h3>
            <p>Listeners can now send you tips! They'll appear here when received.</p>
        </div>
    </div>
}

<!-- Tip Settings Modal -->
@if (_showTipSettings)
{
    <div class="modal-overlay" @onclick="CancelTipSettings">
        <div class="tip-settings-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">💰 Tip Settings</h3>
                <button class="close-modal-btn" @onclick="CancelTipSettings">×</button>
            </div>

            <div class="modal-content">
                <EditForm Model="_djPaymentSettings" OnValidSubmit="SaveTipSettings">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="policy-toggle">
                            <input type="checkbox" @bind="_djPaymentSettings.ShowTipJar" class="toggle-input" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">
                                <span class="toggle-text">Show Tip Jar to Listeners</span>
                                <span class="toggle-description">Allow listeners to send tips during your sessions</span>
                            </span>
                        </label>
                    </div>

                    @if (_djPaymentSettings.ShowTipJar)
                    {
                        <div class="form-group">
                            <label>Tip Jar Message (Optional)</label>
                            <textarea @bind="_djPaymentSettings.TipJarMessage" 
                                      class="form-control" 
                                      rows="2" 
                                      placeholder="Thank you for supporting my music!"
                                      maxlength="150"></textarea>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Minimum Tip Amount</label>
                                <div class="input-group">
                                    <span class="input-prefix">$</span>
                                    <input type="number" @bind="_djPaymentSettings.MinTipAmount" 
                                           class="form-control" min="0.50" max="10" step="0.50" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Maximum Tip Amount</label>
                                <div class="input-group">
                                    <span class="input-prefix">$</span>
                                    <input type="number" @bind="_djPaymentSettings.MaxTipAmount" 
                                           class="form-control" min="10" max="500" step="5" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Preset Tip Amounts (comma-separated)</label>
                            <input type="text" @bind="_djPaymentSettings.PresetAmounts" 
                                   class="form-control" 
                                   placeholder="1,5,10,20" />
                            <small class="form-text">Enter amounts separated by commas (e.g., 1,5,10,20)</small>
                        </div>
                    }

                    <div class="modal-actions">
                        <button type="button" class="btn btn-secondary" @onclick="CancelTipSettings">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Settings</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}



    <div class="songs-section">
        <div class="songs-header">
            <h2 class="section-title">Song Requests</h2>
            <div class="header-controls">
                @if (_currentSortMode == SortMode.Custom)
                {
                    <span class="drag-hint">💡 Drag songs to reorder your playlist</span>
                }

                @if (_isAutoPlayEnabled)
                {
                    <div class="auto-play-controls">
                        <button class="control-btn auto-play-btn previous" @onclick="PlayPreviousSong" disabled="@(_currentAutoPlayIndex <= 0)">
                            <span class="btn-icon">⏮️</span>
                            <span>Previous</span>
                        </button>
                        <button class="control-btn auto-play-btn next" @onclick="PlayNextSong" disabled="@(_currentAutoPlayIndex >= GetDisplaySongs().Count() - 1)">
                            <span class="btn-icon">⏭️</span>
                            <span>Next</span>
                        </button>
                    </div>
                }

                <div class="sort-controls">
                    <label class="sort-label">Sort by:</label>
                    <select class="sort-dropdown" @bind="_currentSortMode" @bind:after="OnSortModeChanged">
                        <option value="@SortMode.MostRecent">Most Recent Request</option>
                        <option value="@SortMode.Oldest">Oldest Request</option>
                        <option value="@SortMode.MostRequested">Most Requested</option>
                        <option value="@SortMode.Custom">Custom Order (Drag & Drop)</option>
                    </select>
                </div>
                <button class="control-btn refresh-btn" @onclick="RefreshRequests" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="loading-spinner"></span>
                    }
                    else
                    {
                        <span class="btn-icon">🔄</span>
                    }
                    <span>Refresh</span>
                </button>
                <button class="control-btn clear-all-btn" @onclick="ShowClearAllConfirmation" disabled="@(!_requestedSongs.Any())">
                    <span class="btn-icon">🗑️</span>
                    <span>Clear All</span>
                </button>
            </div>
        </div>



        @if (_requestedSongs.Any())
        {
            <div class="songs-grid @(_currentSortMode == SortMode.Custom ? "drag-enabled" : "")" id="songs-container">
                @foreach (var songGroup in GetDisplaySongs().Select((song, index) => new { Song = song, Index = index }))
                {

                    <div class="song-card @(songGroup.Song.Uri == _currentlyPlayingSongId ? "currently-playing" : "") @(_currentSortMode == SortMode.Custom ? "draggable" : "") @(_dragTargetIndex == songGroup.Index ? "drag-target" : "") @(_isAutoPlayEnabled && songGroup.Index == _currentAutoPlayIndex ? "auto-play-current" : "")"
                         draggable="@(_currentSortMode == SortMode.Custom ? "true" : "false")"
                         @ondragstart="@(() => OnDragStart(songGroup.Index))"
                         @ondragstart:preventDefault="false"
                         @ondragenter="@(() => OnDragEnter(songGroup.Index))"
                         @ondragenter:preventDefault="true"
                         @ondragover="@(() => OnDragOver(songGroup.Index))"
                         @ondragover:preventDefault="true"
                         @ondragleave="@(() => OnDragLeave(songGroup.Index))"
                         @ondrop="@(() => OnDrop(songGroup.Index))"
                         @ondrop:preventDefault="true"
                         data-position="@songGroup.Index">

                        <!-- Remove button in top right corner -->
                        <button class="remove-corner-btn" @onclick="() => RemoveSongRequest(songGroup.Song.Id)" title="Remove Request">
                            <span class="remove-icon">×</span>
                        </button>

                        <div class="song-header">
                            <div class="song-position">
                                <div class="request-count-badge @(GetRequestCount(songGroup.Song.Id) > 1 ? "popular" : "")">
                                    <span class="count-number">@GetRequestCount(songGroup.Song.Id)</span>
                                    <span class="count-label">request@(GetRequestCount(songGroup.Song.Id) != 1 ? "s" : "")</span>
                                    @if (GetRequestCount(songGroup.Song.Id) >= 5)
                                    {
                                        <span class="hot-indicator">🔥</span>
                                    }
                                </div>
                                @if (songGroup.Song.Uri == _currentlyPlayingSongId)
                                {
                                    <span class="playing-indicator">♪</span>
                                    <span class="position-text">Playing</span>
                                }
                @*                 @if (_isAutoPlayEnabled && songGroup.Index == _currentAutoPlayIndex)
                                {
                                    <span class="auto-play-indicator">🎯</span>
                                    <span class="position-text">Queue Position</span>
                                } *@
                            </div>

                            @if (_currentSortMode == SortMode.Custom)
                            {
                                <div class="drag-handle" title="Drag to reorder">
                                    <span class="drag-dots">⋮⋮</span>
                                </div>
                            }
                        </div>

                        <div class="song-content">
                            <div class="song-cover">
                                @if (!string.IsNullOrEmpty(SpotifyService.GetAlbumImageUrl(songGroup.Song)))
                                {
                                    <img src="@SpotifyService.GetAlbumImageUrl(songGroup.Song)" alt="@songGroup.Song.Name" class="cover-image" />
                                }
                                else
                                {
                                    <div class="cover-placeholder">🎵</div>
                                }
                                @if (songGroup.Song.Uri == _currentlyPlayingSongId)
                                {
                                    <div class="playing-overlay">
                                        <div class="playing-animation">
                                            <span></span>
                                            <span></span>
                                            <span></span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="song-info">
                                <h3 class="song-title">@songGroup.Song.Name  @(@songGroup.Song.Explicit ? "   (EXPLICIT)" : "") </h3>
                                <p class="song-artist">@SpotifySearchService.GetAllArtistNames(songGroup.Song)</p>
                                <p class="song-album">@songGroup.Song.Album?.Name</p>
                                <div class="song-meta">
                                    <span class="duration">⏱️ @SpotifySearchService.FormatDuration(songGroup.Song.DurationMs)</span>
                                    <span class="first-requested">🕐 First: @GetFirstRequestTime(songGroup.Song.Id).ToLocalTime().ToString("HH:mm:ss")</span>
                                    <span class="last-requested">🕘 Latest: @GetLatestRequestTime(songGroup.Song.Id).ToLocalTime().ToString("HH:mm:ss")</span>
                                </div>
                            </div>
                        </div>

                        <div class="song-actions">
                            @if (songGroup.Song.Uri == _currentlyPlayingSongId)
                            {
                                @if (_isPlaying)
                                {
                                    <button class="play-btn pause-state" @onclick="() => PauseSong()">
                                        <span class="btn-icon">⏸️</span>
