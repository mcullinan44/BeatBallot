    // Auto-play methods
    private async Task OnAutoPlayToggled()
    {
        if (_isAutoPlayEnabled)
        {
            // Initialize auto-play
            await InitializeAutoPlay();
        }
        else
        {
            // Disable auto-play
            await DisableAutoPlay();
        }

        StateHasChanged();
    }

    private async Task InitializeAutoPlay()
    {
        try
        {
            var displaySongs = GetDisplaySongs().ToList();
            if (!displaySongs.Any())
            {
                _isAutoPlayEnabled = false;
                _statusMessage = "⚠️ No songs available for auto-play";
                return;
            }

            // Set current index to the currently playing song if any, otherwise start from beginning
            if (!string.IsNullOrEmpty(_currentlyPlayingSongId))
            {
                var currentSongIndex = displaySongs.FindIndex(s => s.Uri == _currentlyPlayingSongId);
                _currentAutoPlayIndex = currentSongIndex >= 0 ? currentSongIndex : 0;
            }
            else
            {
                _currentAutoPlayIndex = 0;
            }

            UpdateNextSongInQueue();
            await StartPlaybackMonitoring();

            _statusMessage = "🔄 Auto-play mode enabled";
            // Clear message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                _statusMessage = "";
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing auto-play: {ex.Message}");
            _isAutoPlayEnabled = false;
            _statusMessage = "❌ Failed to enable auto-play mode";
        }
    }

    private async Task DisableAutoPlay()
    {
        _currentAutoPlayIndex = -1;
        _nextSongInQueue = null;
        await StopPlaybackMonitoring();

        _statusMessage = "⏸️ Auto-play mode disabled";
        // Clear message after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            _statusMessage = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task StartPlaybackMonitoring()
    {
        if (_isMonitoringPlayback) return;

        _isMonitoringPlayback = true;
        _playbackMonitorTimer = new System.Threading.Timer(async _ =>
        {
            if (_isAutoPlayEnabled && _isPlaying && !string.IsNullOrEmpty(_currentlyPlayingSongId))
            {
                await CheckCurrentPlaybackStatus();
            }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5)); // Check every 5 seconds
    }

    private async Task StopPlaybackMonitoring()
    {
        _isMonitoringPlayback = false;
        _playbackMonitorTimer?.Dispose();
        _playbackMonitorTimer = null;
        _currentSongStartTime = null;
        _currentSongDurationMs = null;
    }

    private async Task CheckCurrentPlaybackStatus()
    {
        try
        {
            // This method should check Spotify's current playback state
            // You'll need to implement this in your SpotifyService
            var playbackState = await SpotifyService.GetCurrentPlaybackAsync();

            if (playbackState?.Item == null || !playbackState.IsPlaying)
            {
                // Song has ended or was paused - advance to next if auto-play is enabled
                if (_isAutoPlayEnabled && !_isSessionOver)
                {
                    await InvokeAsync(async () =>
                    {
                        await PlayNextSong();
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking playback status: {ex.Message}");
        }
    }

    private async Task PlayNextSong()
    {
        if (!_isAutoPlayEnabled || _isSessionOver) return;

        var displaySongs = GetDisplaySongs().ToList();
        if (_currentAutoPlayIndex >= displaySongs.Count - 1)
        {
            // End of queue
            _statusMessage = "🎉 Reached end of song queue";
            _isAutoPlayEnabled = false;
            UpdateNextSongInQueue();
            StateHasChanged();
            return;
        }

        _currentAutoPlayIndex++;
        var nextSong = displaySongs[_currentAutoPlayIndex];
        await PlaySong(nextSong.Uri, _currentAutoPlayIndex);
        UpdateNextSongInQueue();
    }

    private async Task PlayPreviousSong()
    {
        if (!_isAutoPlayEnabled || _currentAutoPlayIndex <= 0) return;

        _currentAutoPlayIndex--;
        var displaySongs = GetDisplaySongs().ToList();
        var previousSong = displaySongs[_currentAutoPlayIndex];
        await PlaySong(previousSong.Uri, _currentAutoPlayIndex);
        UpdateNextSongInQueue();
    }

    private void UpdateNextSongInQueue()
    {
        var displaySongs = GetDisplaySongs().ToList();
        if (_isAutoPlayEnabled && _currentAutoPlayIndex >= 0 && _currentAutoPlayIndex < displaySongs.Count - 1)
        {
            _nextSongInQueue = displaySongs[_currentAutoPlayIndex + 1];
        }
        else
        {
            _nextSongInQueue = null;
        }
    }

    // Policy management methods
