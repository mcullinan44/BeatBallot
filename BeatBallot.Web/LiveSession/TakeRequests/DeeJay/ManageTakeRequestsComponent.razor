            _sessionPolicy.SessionId = SessionId;

            // Update the session policy via SignalR to notify all listeners
            if (_hubConnection?.State == HubConnectionState.Connected)
            {
                await _hubConnection.SendAsync("UpdateSessionPolicy", SessionId, _sessionPolicy);
            }

            // Save to cache service
            await SongRequestCacheService.UpdateSessionPolicyAsync(SessionId, _sessionPolicy);

            // Log the policy change
            SessionActivityLogger.LogPolicyChange(SessionId, _originalSessionPolicy, _sessionPolicy, _djUserName);


            // Update original policy and clear pending changes
            _originalSessionPolicy = new SessionPolicy
            {
                SessionId = _sessionPolicy.SessionId,
                BlockExplicitContent = _sessionPolicy.BlockExplicitContent,
                MaxRequestsPerListener = _sessionPolicy.MaxRequestsPerListener,
                MinSongDurationMs = _sessionPolicy.MinSongDurationMs,
                MaxSongDurationMs = _sessionPolicy.MaxSongDurationMs,
                BlockedArtists = new List<string>(_sessionPolicy.BlockedArtists),
                BlockedGenres = new List<string>(_sessionPolicy.BlockedGenres),
                AllowDuplicateRequests = _sessionPolicy.AllowDuplicateRequests,
                ShowRequestsToListeners = _sessionPolicy.ShowRequestsToListeners,
                PolicyMessage = _sessionPolicy.PolicyMessage,
                CreatedAt = _sessionPolicy.CreatedAt,
                UpdatedAt = _sessionPolicy.UpdatedAt,
                DjUserId = _sessionPolicy.DjUserId
            };

            _policyChangesPending = false;
            _statusMessage = "✅ Session policies updated successfully";

            // Clear message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                _statusMessage = "";
                InvokeAsync(StateHasChanged);
            });

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating session policy: {ex.Message}");
            _statusMessage = "❌ Failed to update session policies. Please try again.";
            StateHasChanged();
        }
