    private void ShowStopConfirmation()
    {
        _showStopConfirmation = true;
    }

    private void CancelStop()
    {
        _showStopConfirmation = false;
    }

    private async Task ConfirmStop()
    {
        _showStopConfirmation = false;

        try
        {
            // Disable auto-play when stopping session
            if (_isAutoPlayEnabled)
            {
                await DisableAutoPlay();
            }

            // Stop accepting requests via SignalR
            if (_hubConnection?.State == HubConnectionState.Connected)
            {
                await _hubConnection.SendAsync("StopAcceptingRequests", SessionId);
            }

            SessionActivityLogger.LogSessionEnded(SessionId, _djUserName, _requestedSongs.Count, DateTime.Now - _sessionStartTime);

            // Deactivate session in cache
            await SongRequestCacheService.DeactivateSessionAsync(SessionId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping session: {ex.Message}");
        }

        _isSessionOver = true;
        StateHasChanged();
        //Navigation.NavigateTo("/dj/startsession");
    }

    private void ShowClearAllConfirmation()
    {
        _showClearAllConfirmation = true;
    }

    private void CancelClearAll()
    {
        _showClearAllConfirmation = false;
    }

    private async Task ConfirmClearAll()
    {
        _showClearAllConfirmation = false;

        try
        {
            // Clear from cache service first
            var result = await SongRequestCacheService.ClearAllRequestsAsync(SessionId);

            if (result.Success)
            {
                // Clear local lists
                _requestedSongs.Clear();
                _customOrderSongs.Clear();
                _songRequestGroups.Clear();
                _totalRequests = 0;
                _totalUniqueRequests = 0;

                // Reset auto-play state
                if (_isAutoPlayEnabled)
                {
                    _currentAutoPlayIndex = -1;
                    _nextSongInQueue = null;
                }

                StateHasChanged();
            }
            else
            {
                Console.WriteLine($"Failed to clear all requests: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing all requests: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dj/startsession");
    }

    private string GetSessionDuration()
    {
        if (_isSessionOver)
            return _sessionTime;

        var duration = DateTime.Now - _sessionStartTime;

        _sessionTime = $"{duration.Hours:D2}:{duration.Minutes:D2}:{duration.Seconds:D2}";
        return _sessionTime;
    }

    private void StartDurationTimer()
    {
        _durationTimer = new System.Threading.Timer(async _ => { await InvokeAsync(StateHasChanged); }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    public async ValueTask DisposeAsync()
    {
        _durationTimer?.Dispose();
        await StopPlaybackMonitoring();

        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.SendAsync("LeaveDJSession", SessionId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error leaving DJ session: {ex.Message}");
            }

            await _hubConnection.DisposeAsync();
        }
    }

