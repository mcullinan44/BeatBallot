@* RequestComponent.razor *@
@page "/request/{SessionId}"
@using System.Text.Json
@using BeatBallot.Web.Services.Spotify
@using Microsoft.AspNetCore.SignalR.Client
@using SpotifyAPI.Web
@using BeatBallot.Web.LiveSession.VotingExperience.Listener.Vote
@using BeatBallot.Web.Services
@using BeatBallot.Web.Services.Local

@inject NavigationManager Navigation
@inject SpotifySearchService SpotifySearchService
@inject ISongRequestCacheService SongRequestCacheService
@inject IDeviceService DeviceService
@inject IJSRuntime JSRuntime
@inject ISessionActivityLogger SessionActivityLogger


@implements IAsyncDisposable

@if (_isInitialized)
{
    <div class="vote-container">
        <HeaderComponent></HeaderComponent>
        <div class="request-page">
            <div class="section-title">
                <span>Request Songs</span>
                <div style="display: flex; align-items: center; gap: 15px; margin-top:-40%;margin-bottom: 25%;z-index:99999; margin-left:85%;">
                    @if (!_isConnectedToHub && _sessionEnded)
                    {
                        <div class="connection-status offline">
                            <span style="margin-top:-5px;">⚠️</span>
                        </div>
                    }
                    else @if (!_isConnectedToHub)
                    {
                        <div class="connection-status offline">
                            <span style="margin-top:-5px;">⚠️</span>
                        </div>
                    }
                    else
                    {
                        <div class="connection-status online">
                            <span style="margin-top:0px;">🟢</span>
                        </div>
                    }
                </div>
            </div>


            <!-- Search Section -->
            <div class="search-section">
                <div class="search-container">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text"
                               class="search-input"
                               placeholder="Search for songs, artists, or albums..."
                               @bind="_searchQuery"
                               @oninput="OnSearchInput"
                               @onkeypress="OnKeyPress"
                               disabled="@(!_isConnectedToHub)"
                               autocomplete="off" />
                        @if (!string.IsNullOrEmpty(_searchQuery))
                        {
                            <button class="clear-search-btn" @onclick="ClearSearch">×</button>
                        }
                    </div>

                    @if (_isSearching)
                    {
                        <div class="search-loading">
                            <span class="loading-spinner"></span>
                            <span>Searching BeatBallot...</span>
                        </div>
                    }
                </div>

                <!-- Auto-complete Results -->
                @if (_searchResults.Any() && !string.IsNullOrEmpty(_searchQuery))
                {
                    <div class="autocomplete-results">
                        @foreach (var track in _searchResults.Take(8))
                        {
                            <div class="search-result-item @(IsTrackRequested(track.Id) ? "already-requested" : "")"
                                 @onclick="() => RequestTrack(track)">
                                <div class="track-cover">
                                    @if (!string.IsNullOrEmpty(SpotifySearchService.GetAlbumImageUrl(track)))
                                    {
                                        <img src="@SpotifySearchService.GetAlbumImageUrl(track)" alt="@track.Name" class="cover-image" />
                                    }
                                    else
                                    {
                                        
                                    }
                                </div>
                                <div class="track-info">
                                    <p class="track-name">@(track.Name + (track.Explicit ? " (E) " : ""))</p>
                                    <p class="track-artist">@SpotifySearchService.GetAllArtistNames(track)</p>
                                    <p class="track-album">@track.Album?.Name</p>
                                </div>
                                <div class="track-actions">
                                    @if (IsTrackRequested(track.Id))
                                    {
                                        <span class="requested-badge">✓ Requested</span>
                                    }
                                    else
                                    {
                                        <button class="request-btn">
                                            <span class="btn-icon">+</span>
                                            <span>Add to Bag</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Requested Songs Section -->
            @if (_requestedSongs.Any())
            {
                <div class="requested-section">
                    <div class="section-header">
                        <h2 class="section-title">Your Requests</h2>
                        @*           <button class="clear-all-btn" @onclick="ClearAllRequests">
                            <span class="btn-icon">🗑️</span>
                            <span>Clear All</span>
                        </button> *@
                    </div>

                    <div class="requested-songs-list">
                        @foreach (var request in _requestedSongs.OrderBy(r => r.RequestedAt))
                        {
                            <div class="requested-song-item">
                                <div class="song-position">
                                    @(_requestedSongs.IndexOf(request) + 1)
                                </div>
                                <div class="song-cover">
                                    @if (!string.IsNullOrEmpty(SpotifySearchService.GetAlbumImageUrl(request.Song)))
                                    {
                                        <img src="@SpotifySearchService.GetAlbumImageUrl(request.Song)" alt="@request.Song.Name" class="cover-image" />
                                    }
                                    else
                                    {
                                        <div class="cover-placeholder">🎵</div>
                                    }
                                </div>
                                <div class="song-info">
                                    <h3 class="song-name">@request.Song.Name</h3>
                                    <p class="song-artist">@SpotifySearchService.GetAllArtistNames(request.Song)</p>
                                    <p class="song-album">@request.Song.Album?.Name</p>
                                    <span class="request-time">Requested @request.RequestedAt.ToString("HH:mm")</span>
                                </div>
                                <div class="song-actions">
                                    <button class="remove-btn" @onclick="() => RemoveRequest(request)">
                                        <span class="btn-icon">×</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    
                    
                    
                    <!-- User Name Section -->
                    <div class="name-section">
                        <div class="name-input-wrapper">
                            <span class="name-icon">👤</span>
                            <input type="text"
                                   class="name-input"
                                   placeholder="Enter your name (optional)"
                                   @bind="_userName"
                                   maxlength="50"
                                   autocomplete="off" />
                            @if (!string.IsNullOrEmpty(_userName))
                            {
                                <button class="clear-name-btn" @onclick="ClearName">×</button>
                            }
                        </div>
                        <div class="name-preview">
                            Requesting as: <strong>@(string.IsNullOrWhiteSpace(_userName) ? "Anonymous" : _userName)</strong>
                        </div>
                    </div>


                    <div class="request-actions">
                        <button class="submit-requests-btn" @onclick="SubmitRequests"
                                disabled="@(_isSubmitting || !_isConnectedToHub)">
                            @if (_isSubmitting)
                            {
                                <span class="loading-spinner"></span>
                                <span>Submitting...</span>
                            }
                            else
                            {
                                <span>Submit @_requestedSongs.Count Request@(_requestedSongs.Count != 1 ? "s" : "")</span>
                            }
                        </button>
                    </div>
                </div>
            }

            @if (!_requestedSongs.Any() && string.IsNullOrEmpty(_searchQuery))
            {
                <div class="empty-state">
                    <div class="empty-icon">🎵</div>
                    <h2>Start Requesting Songs</h2>
                    <p>Search for your favorite tracks and request songs for the DJ to consider.</p>
                </div>
            }

            <!-- Success Message -->
            @if (_showSuccessMessage)
            {
                <div class="success-overlay" @onclick="HideSuccessMessage">
                    <div class="success-modal" @onclick:stopPropagation="true">
                        
                        <h3>Requests Submitted!</h3>
                        <p>Your @_submittedCount song request@(_submittedCount != 1 ? "s have" : " has") been sent to the DJ.</p>
                        @if (_duplicateCount > 0)
                        {
                            <p class="duplicate-info">(@_duplicateCount duplicate@(_duplicateCount != 1 ? "s" : "") ignored)</p>
                        }
                        <button class="close-success-btn" @onclick="HideSuccessMessage">Continue</button>
                    </div>
                </div>
            }

            <!-- Error Message -->
            @if (_showErrorMessage)
            {
                <div class="success-overlay" @onclick="HideErrorMessage">
                    <div class="success-modal error-modal" @onclick:stopPropagation="true">
                        
                        <p>@_errorMessage</p>
                        <button class="close-success-btn" @onclick="HideErrorMessage">Close</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <TipJarComponent SessionId="@SessionId" HubConnection="_hubConnection" />
}
else
{
    <p>Joining session...</p>
}

@code {
    [Parameter] public string SessionId { get; set; } = "";

    private bool _isInitialized;
    private string _deviceId = string.Empty;
    private bool _hasJoined = false;
    private bool _isSearching;
    private bool _isSubmitting;
    private bool _showSuccessMessage;
    private bool _showErrorMessage;
    private bool _isConnectedToHub;
    private bool _sessionEnded; // Track if the session has ended
    private int _submittedCount;
    private int _duplicateCount;
    private string _errorMessage = "";
    private string _searchQuery = "";
    private string _userName = "";
    private int _deviceCount = 0;
    private System.Threading.Timer? _searchTimer;
    private HubConnection? _hubConnection;

    private List<FullTrack> _searchResults = new();
    private List<SongRequest> _requestedSongs = new();

    protected override async Task OnInitializedAsync()
    {
        // Validate session ID
        if (string.IsNullOrEmpty(SessionId))
        {
            Navigation.NavigateTo("/");
            return;
        }

        await InitializeSignalRConnection();

        _deviceId = await DeviceService.GetOrCreateDeviceIdAsync();

        _hasJoined = await DeviceService.IsDeviceInSessionAsync(_deviceId, SessionId);
            
        if (_hasJoined)
        {
            await UpdateDeviceCount();
        }
        else
        {
            await DeviceService.AddDeviceToSessionAsync(_deviceId, SessionId);


            var deviceInfo = await DeviceService.GetDeviceInfoAsync(_deviceId);
            // Log the song request
            SessionActivityLogger.LogDeviceJoined(SessionId, string.Empty, deviceInfo);




        }

        _isInitialized = true;
    }


    private async Task UpdateDeviceCount()
    {
        try
        {
            var devices = await DeviceService.GetSessionDevicesAsync(SessionId);
            _deviceCount = devices.Count();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            
        }
    }

    private async Task InitializeSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/songRequestHub"))
                .Build();

            // Handle connection state changes
            _hubConnection.Closed += async (error) =>
            {
                _isConnectedToHub = false;
                await InvokeAsync(StateHasChanged);

                // Attempt to reconnect after a delay
                await Task.Delay(500);
                await StartConnection();
            };

            // Listen for session status updates
            _hubConnection.On<object>("SessionInactive", async (data) =>
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = "This session is not currently accepting requests.";
                    _showErrorMessage = true;
                    StateHasChanged();
                });
            });

            // Listen for successful session join
            _hubConnection.On<object>("ListenerSessionJoined", async (data) =>
            {
                _isConnectedToHub = true;
                await InvokeAsync(StateHasChanged);
            });

            // Listen for request submission results
            _hubConnection.On<object>("RequestsSubmitted", async (result) =>
            {
                await InvokeAsync(() =>
                {
                    try
                    {
                        
                        var options = new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        };
                        var resultJson = System.Text.Json.JsonSerializer.Serialize(result);
                        var resultData = System.Text.Json.JsonSerializer.Deserialize<SongRequestResult>(resultJson, options);

                        if (resultData?.Success == true)
                        {
                            _submittedCount = resultData.SongsAdded;
                            _duplicateCount = resultData.DuplicateSongs?.Count ?? 0;
                            _requestedSongs.Clear();
                            _showSuccessMessage = true;
                        }
                        else
                        {
                            _errorMessage = resultData?.Message ?? "Unknown error occurred";
                            _showErrorMessage = true;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error parsing result: {ex.Message}");
                        _errorMessage = "Error processing response from server";
                        _showErrorMessage = true;
                    }

                    _isSubmitting = false;
                    StateHasChanged();
                });
            });

            // Listen for request errors
            _hubConnection.On<string>("RequestError", async (errorMessage) =>
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = errorMessage;
                    _showErrorMessage = true;
                    _isSubmitting = false;
                    StateHasChanged();
                });
            });

            // Listen for session stopped notifications
            _hubConnection.On<object>("RequestsStopped", async (data) =>
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = "Sorry :(. The DJ is no longer accepting song requests for this session. Find a new QR Code to try again!"; 
                    _hubConnection.SendAsync("LeaveListenerSession", SessionId);
                    
                    _isConnectedToHub = false;
                    _sessionEnded = true;
                    _showErrorMessage = true;
                    StateHasChanged();
                });
            });

            // Listen for successful session join
            _hubConnection.On<object>("LeaveDJSession", async (data) =>
            {
                _isConnectedToHub = false;
                _sessionEnded = true;
                _hubConnection.SendAsync("LeaveListenerSession", SessionId);
                _hubConnection.DisposeAsync();

                await InvokeAsync(StateHasChanged);
            });



            await StartConnection();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing SignalR connection: {ex.Message}");
            _errorMessage = "Failed to connect to server. Please refresh the page.";
            _showErrorMessage = true;
        }
    }

    private async Task StartConnection()
    {
        try
        {
            await _hubConnection.StartAsync();

            // Join the session as a listener
            await _hubConnection.SendAsync("JoinListenerSession", SessionId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting SignalR connection: {ex.Message}");
            _isConnectedToHub = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";

        // Clear previous timer
        _searchTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchResults.Clear();
            StateHasChanged();
            return;
        }

        // Debounce search - wait 500ms after user stops typing
        _searchTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await PerformSearch();
            });
        }, null, TimeSpan.FromMilliseconds(250), Timeout.InfiniteTimeSpan);
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchTimer?.Dispose();
            await PerformSearch();
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return;

        _isSearching = true;
        StateHasChanged();

        try
        {
            // Use the SpotifyService to search for tracks
            var tracks = await SpotifySearchService.GetTracksListAsync(_searchQuery, limit: 20, 0, null, SessionId);
            _searchResults = tracks ?? new List<FullTrack>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            _searchResults.Clear();
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _searchResults.Clear();
        _searchTimer?.Dispose();
        StateHasChanged();
    }

    private void ClearName()
    {
        _userName = "";
        StateHasChanged();
    }

    private bool IsTrackRequested(string trackId)
    {
        return _requestedSongs.Any(r => r.Song.Id == trackId);
    }

    private async Task RequestTrack(FullTrack track)
    {
        if (IsTrackRequested(track.Id))
            return;

        var request = new SongRequest
        {
            Song = track,
            RequestedAt = DateTime.UtcNow,
            SessionId = SessionId
        };

        _requestedSongs.Add(request);

        // Clear search after adding
        _searchQuery = "";
        _searchResults.Clear();

        StateHasChanged();

        // Optional: Show brief feedback
        await Task.Delay(100);
    }

    private void RemoveRequest(SongRequest request)
    {
        _requestedSongs.Remove(request);
        StateHasChanged();
    }

    private void ClearAllRequests()
    {
        _requestedSongs.Clear();
        StateHasChanged();
    }

    private async Task SubmitRequests()
    {
        if (!_requestedSongs.Any() || _isSubmitting)
            return;

        // Check if connected to SignalR hub
        if (_hubConnection?.State != HubConnectionState.Connected)
        {
            Console.WriteLine("Not connected to SignalR hub. Attempting to reconnect...");
            await StartConnection();

            if (_hubConnection?.State != HubConnectionState.Connected)
            {
                _errorMessage = "Failed to connect to server. Please try again.";
                _showErrorMessage = true;
                return;
            }
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            // Create song request list for submission
            var songRequestList = new SongRequestList
            {
                SessionId = SessionId,
                Songs = _requestedSongs.ToList(), // Copy the list
                RequestedAt = DateTime.UtcNow,
                RequesterName = string.IsNullOrWhiteSpace(_userName) ? "Anonymous" : _userName.Trim(),
                DeviceId = _deviceId
            };

            // Submit through SignalR hub which will use the cache service and notify DJ
            await _hubConnection.SendAsync("SubmitSongRequests", songRequestList);

            // Note: The response will be handled by the SignalR event handlers
            // The UI will be updated when "RequestsSubmitted" or "RequestError" events are received
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Submit error: {ex.Message}");
            _errorMessage = "Failed to submit requests. Please try again.";
            _showErrorMessage = true;
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void HideSuccessMessage()
    {
        _showSuccessMessage = false;
        StateHasChanged();
    }

    private void HideErrorMessage()
    {
        _showErrorMessage = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _searchTimer?.Dispose();

        if (_hubConnection is not null)
        {
            try
            {
                // Leave the session before disposing
                await _hubConnection.SendAsync("LeaveListenerSession", SessionId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error leaving session: {ex.Message}");
            }

            await _hubConnection.DisposeAsync();
        }
    }

    // DTO classes for SignalR responses
    public class SongRequestResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public int SongsAdded { get; set; }
        public List<string>? DuplicateSongs { get; set; }
    }

