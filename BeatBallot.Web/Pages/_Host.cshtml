 </script>


<script>
        // wwwroot/js/deviceInfo.js
        // Client-side device information collection for BeatBallot

        window.getClientDeviceInfo = () => {
            try {
                return {
                    screenResolution: `${screen.width}x${screen.height}`,
                    timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone
                };
            } catch (error) {
                console.warn('Could not collect device info:', error);
                return {
                    screenResolution: 'unknown',
                    timeZone: 'unknown'
                };
            }
        };

        window.generateClientFingerprint = () => {
            try {
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                ctx.textBaseline = 'top';
                ctx.font = '14px Arial';
                ctx.fillText('BeatBallot', 2, 2);

                return {
                    canvas: canvas.toDataURL(),
                    userAgent: navigator.userAgent,
                    language: navigator.language,
                    platform: navigator.platform,
                    cookieEnabled: navigator.cookieEnabled,
                    touchSupport: 'ontouchstart' in window,
                    screenResolution: `${screen.width}x${screen.height}`,
                    timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                    colorDepth: screen.colorDepth,
                    pixelRatio: window.devicePixelRatio || 1
                };
            } catch (error) {
                console.warn('Could not generate fingerprint:', error);
                return {
                    userAgent: navigator.userAgent || 'unknown',
                    language: navigator.language || 'unknown',
                    platform: navigator.platform || 'unknown',
                    cookieEnabled: navigator.cookieEnabled || false,
                    touchSupport: 'ontouchstart' in window
                };
            }
        };

        // Helper function to check if device is mobile
        window.isMobileDevice = () => {
            const userAgent = navigator.userAgent || '';
            const mobileKeywords = ['Mobile', 'Android', 'iPhone', 'iPad', 'Windows Phone', 'BlackBerry'];
            return mobileKeywords.some(keyword => userAgent.includes(keyword));
        };

        // Function to get network information (if available)
        window.getNetworkInfo = () => {
            try {
                if ('connection' in navigator) {
                    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
                    return {
                        effectiveType: connection.effectiveType,
                        downlink: connection.downlink,
                        rtt: connection.rtt
                    };
                }
                return null;
            } catch (error) {
                return null;
            }
        };

        // Enhanced device info with additional details
        window.getExtendedDeviceInfo = () => {
            try {
                const basicInfo = window.getClientDeviceInfo();
                const fingerprint = window.generateClientFingerprint();
                const networkInfo = window.getNetworkInfo();

                return {
                    ...basicInfo,
                    isMobile: window.isMobileDevice(),
                    network: networkInfo,
                    viewport: {
                        width: window.innerWidth,
                        height: window.innerHeight
                    },
                    orientation: screen.orientation ? screen.orientation.type : 'unknown',
                    hardwareConcurrency: navigator.hardwareConcurrency || 'unknown',
                    maxTouchPoints: navigator.maxTouchPoints || 0,
                    fingerprint: fingerprint
                };
            } catch (error) {
                console.warn('Could not collect extended device info:', error);
                return window.getClientDeviceInfo();
            }
        };
</script>


<script>
        window.blazorCookies = {
            set: function (name, value, hours) {
                try {
                    const expires = new Date();
                    expires.setTime(expires.getTime() + (hours * 60 * 60 * 1000));

                    document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires.toUTCString()}; path=/; SameSite=Lax; Secure=${location.protocol === 'https:'}`;
                    return true;
                } catch (error) {
                    console.error('Error setting cookie:', error);
                    return false;
                }
            },

            get: function (name) {
                try {
                    const nameEQ = name + "=";
                    const cookies = document.cookie.split(';');

                    for (let i = 0; i < cookies.length; i++) {
                        let cookie = cookies[i];
                        while (cookie.charAt(0) === ' ') {
                            cookie = cookie.substring(1, cookie.length);
                        }
                        if (cookie.indexOf(nameEQ) === 0) {
                            return decodeURIComponent(cookie.substring(nameEQ.length, cookie.length));
                        }
                    }
                    return null;
                } catch (error) {
                    console.error('Error getting cookie:', error);
                    return null;
                }
            },

            remove: function (name) {
                try {
                    document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; SameSite=Lax`;
                    return true;
                } catch (error) {
                    console.error('Error removing cookie:', error);
                    return false;
                }
            }
        };
    </script>

        <script>
        // Updated wwwroot/js/stripe-integration.js
          let stripeInstances = new Map(); // Track multiple Stripe instances

          window.checkElementExists = (elementId) => {
              const element = document.getElementById(elementId);
              return element !== null;
          };

          window.waitForElement = async (elementId, maxAttempts = 10, delay = 100) => {
              for (let i = 0; i < maxAttempts; i++) {
                  if (document.getElementById(elementId)) {
                      return true;
                  }
                  await new Promise(resolve => setTimeout(resolve, delay));
              }
              return false;
          };

          window.initializeStripeWithId = async (publishableKey, elementId, errorsId) => {

              //return true;
              try {
                  console.log(`Initializing Stripe for element: ${elementId}`);

                  if (typeof Stripe === 'undefined') {
                      console.error('Stripe.js library not loaded');
                      return false;
                  }

                  // Wait for the element to exist
                  const elementExists = await window.waitForElement(elementId, 20, 50);
                  if (!elementExists) {
                      console.error(`${elementId} not found after waiting`);
                      return false;
                  }

                  const stripe = Stripe(publishableKey);
                  const elements = stripe.elements();

                  const cardElement = elements.create('card', {
                      style: {
                          base: {
                              fontSize: '16px',
                              color: '#424770',
                              '::placeholder': {
                                  color: '#aab7c4',
                              },
                          },
                      },
                  });

                  // Mount the element
                  cardElement.mount(`#${elementId}`);

                  // Store the instance for cleanup
                  stripeInstances.set(elementId, {
                      stripe: stripe,
                      elements: elements,
                      cardElement: cardElement
                  });

                  // Listen for validation errors
                  cardElement.on('change', ({error}) => {
                      const displayError = document.getElementById(errorsId);
                      if (displayError) {
                          if (error) {
                              displayError.textContent = error.message;
                          } else {
                              displayError.textContent = '';
                          }
                      }
                  });

                  console.log(`Stripe initialized successfully for ${elementId}`);
                  return true;

              } catch (error) {
                  console.error('Error initializing Stripe:', error);
                  return false;
              }
          };

          window.cleanupStripe = (elementId) => {
              try {
                  const instance = stripeInstances.get(elementId);
                  if (instance && instance.cardElement) {
                      console.log(`Cleaning up Stripe for element: ${elementId}`);

                      // Check if element still exists before unmounting
                      const element = document.getElementById(elementId);
                      if (element) {
                          instance.cardElement.unmount();
                      }

                      // Remove from tracking
                      stripeInstances.delete(elementId);
                  }
              } catch (error) {
                  console.error('Error cleaning up Stripe:', error);
              }
          };

          window.processStripePayment = async (clientSecret, email, elementId) => {
              try {
                  const instance = stripeInstances.get(elementId);
                  if (!instance || !instance.stripe || !instance.cardElement) {
                      console.error('Stripe not properly initialized for element:', elementId);
                      return false;
                  }

                  const { error, paymentIntent } = await instance.stripe.confirmCardPayment(clientSecret, {
                      payment_method: {
                          card: instance.cardElement,
                          billing_details: {
                              email: email
                          }
                      }
                  });

                  if (error) {
                      console.error('Payment failed:', error);
                      return false;
                  } else if (paymentIntent.status === 'succeeded') {
                      console.log('Payment succeeded!');
                      return true;
                  }

                  return false;
              } catch (error) {
                  console.error('Error processing payment:', error);
                  return false;
              }
          };

          // Cleanup on page unload
          window.addEventListener('beforeunload', () => {
              stripeInstances.forEach((instance, elementId) => {
                  window.cleanupStripe(elementId);
              });
          });
        </script>

</body>
<style>

    /* Fixed CSS for the reconnection UI */
