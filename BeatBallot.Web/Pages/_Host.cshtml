@page "/"
@using BeatBallot.Web
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Mvc.TagHelpers
@namespace BeatBallot.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" href="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7">
    <base href="~/" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="BeatBallot.Web.styles.css" rel="stylesheet" />
    <script src="https://js.stripe.com/v3/"></script>
    <component type="typeof(HeadOutlet)" render-mode="Server" />
    
    <!-- Loading background styles -->
    <style>
        html, body {
            background: #1A2042;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .app-loading {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #1A2042;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .loading-content {
            text-align: center;
            color: white;
        }

        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255,255,255,0.2);
            border-top: 4px solid #e74c3c;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        .loading-text {
            font-size: 1.2em;
            font-weight: 600;
            background: #1A2042;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .blazor-ready {
            background: #1A2042;
        }

        .blazor-ready .app-loading {
            display: none;
            background: #1A2042;
        }

        #blazor-error-ui:not(.custom-reconnect-ui) {
            display: none !important;
        }
    </style>
</head>
<body>
    <!-- Loading screen shown while Blazor initializes -->
    <div class="app-loading" id="app-loading">
        <div class="loading-content">
            <div class="loading-text">BeatBallot</div>
            <p style="color: #1A2042; margin-top: 10px;">Loading your music experience...</p>
        </div>
    </div>

    <!-- Your Blazor app -->
    <component type="typeof(App)" render-mode="Server" />

    <!-- Your custom reconnection UI -->
    <div id="blazor-error-ui" class="custom-reconnect-ui">
        <div class="reconnect-overlay">
            <div class="reconnect-modal">
                <div class="reconnect-icon">
                    <svg class="spinner" viewBox="0 0 50 50" width="50" height="50">
                        <circle class="path" cx="25" cy="25" r="20" fill="none" stroke="#3498db" stroke-width="3" stroke-linecap="round" stroke-dasharray="90, 150" stroke-dashoffset="0">
                            <animateTransform attributeName="transform" attributeType="XML" type="rotate" dur="2s" repeatCount="indefinite" values="0 25 25;360 25 25" />
                        </circle>
                    </svg>
                </div>
                <h3 class="reconnect-title">Connection Lost</h3>
                <p class="reconnect-message">Attempting to reconnect to BeatBallot...</p>
                <div class="reconnect-actions">
                    <button class="reconnect-btn" onclick="location.reload()">Refresh Page</button>
                </div>
            </div>
        </div>
    </div>

<script src="_framework/blazor.server.js"></script>

<!-- Hide loading screen when Blazor is ready -->
<script>
    window.addEventListener('DOMContentLoaded', function() {
        // Hide loading screen when Blazor is ready
        if (window.Blazor) {
            document.body.classList.add('blazor-ready');
        } else {
            // Wait for Blazor to load
            const checkBlazor = setInterval(() => {
                if (window.Blazor) {
                    document.body.classList.add('blazor-ready');
                    clearInterval(checkBlazor);
                }
            }, 100);
        }
    });

    // Alternative: Hide loading after a delay as fallback
    setTimeout(() => {
        document.body.classList.add('blazor-ready');
    }, 5000); // 5 second fallback
</script>

