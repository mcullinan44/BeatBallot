        display: none; /* Hidden until max retries reached */
    }

    .reconnect-btn {
        background: linear-gradient(45deg, #e74c3c, #c0392b);
        border: none;
        border-radius: 12px;
        padding: 12px 24px;
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1em;
    }

        .reconnect-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(231, 76, 60, 0.4);
        }

    /* Pulse animation for the modal */
    .reconnect-modal {
        animation: reconnectPulse 2s ease-in-out infinite;
    }

    


    /* Hide default Blazor error UI */
    #blazor-error-ui:not(.custom-reconnect-ui) {
        display: none !important;
    }
</style>
<script>
    window.blazorReconnection = {
        maxRetries: 8,
        retryInterval: 2000,
        currentRetries: 0,
        isReconnecting: false,

        initialize() {
            console.log('Initializing custom Blazor reconnection...');

            // Wait for Blazor to be available
            if (window.Blazor && window.Blazor._internal) {
                this.setupConnectionHandlers();
            } else {
                // Wait for Blazor to load
                document.addEventListener('DOMContentLoaded', () => {
                    setTimeout(() => this.initialize(), 100);
                });
            }
        },

        setupConnectionHandlers() {
            try {
                const connection = window.Blazor._internal.navigationManager._connection;

                if (connection) {
                    // Handle disconnection
                    connection.onclose((error) => {
                        console.log('Blazor connection closed:', error);
                        this.showReconnectUI();
                        this.startReconnection();
                    });

                    // Handle reconnecting state
                    connection.onreconnecting((error) => {
                        console.log('Blazor reconnecting...', error);
                        this.showReconnectUI();
                        this.isReconnecting = true;
                    });

                    // Handle successful reconnection
                    connection.onreconnected((connectionId) => {
                        console.log('Blazor reconnected:', connectionId);
                        this.hideReconnectUI();
                        this.resetReconnection();
                    });

                    console.log('Connection handlers set up successfully');
                }
            } catch (error) {
                console.error('Error setting up connection handlers:', error);
            }
        },

        showReconnectUI() {
            const errorUI = document.getElementById('blazor-error-ui');
            if (errorUI) {
                errorUI.style.display = 'flex';
            }
        },

        hideReconnectUI() {
            const errorUI = document.getElementById('blazor-error-ui');
            if (errorUI) {
                errorUI.style.display = 'none';
            }
        },

        async startReconnection() {
            if (this.isReconnecting) return;

            this.isReconnecting = true;
            this.currentRetries = 0;

            while (this.currentRetries < this.maxRetries && this.isReconnecting) {
                this.currentRetries++;

                this.updateReconnectMessage(`Attempt ${this.currentRetries} of ${this.maxRetries}...`);

                try {
                    // Wait before retry
                    await new Promise(resolve => setTimeout(resolve, this.retryInterval));

                    // Check if we're back online
                    if (!navigator.onLine) {
                        this.updateReconnectMessage('No internet connection. Waiting...');
                        continue;
                    }

                    // Try to make a simple fetch request to test connectivity
                    const response = await fetch(window.location.origin + '/health', {
                        method: 'HEAD',
                        cache: 'no-cache'
                    });

                    if (response.ok) {
                        // Connection seems to be back, reload the page
                        this.updateReconnectMessage('Connection restored. Reloading...');
                        setTimeout(() => location.reload(), 1000);
                        return;
                    }

                } catch (error) {
                    console.log(`Reconnection attempt ${this.currentRetries} failed:`, error);
                }
            }

            // Max retries reached
            this.showFailedReconnect();
        },

        resetReconnection() {
            this.isReconnecting = false;
            this.currentRetries = 0;
            this.updateReconnectMessage('Attempting to reconnect to BeatBallot...');

            // Hide the actions button
            const actionsEl = document.querySelector('.reconnect-actions');
            if (actionsEl) actionsEl.style.display = 'none';
        },

        updateReconnectMessage(message) {
            const messageEl = document.querySelector('.reconnect-message');
            if (messageEl) {
                messageEl.textContent = message;
            }
        },

        showFailedReconnect() {
            const titleEl = document.querySelector('.reconnect-title');
            const messageEl = document.querySelector('.reconnect-message');
            const actionsEl = document.querySelector('.reconnect-actions');

            if (titleEl) titleEl.textContent = 'Connection Failed';
            if (messageEl) messageEl.textContent = 'Unable to reconnect. Please refresh the page.';
            if (actionsEl) actionsEl.style.display = 'block';

            this.isReconnecting = false;
        }
    };

    // Initialize when the page loads
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            window.blazorReconnection.initialize();
        });
    } else {
        window.blazorReconnection.initialize();
    }

    // Also handle online/offline events
    window.addEventListener('online', () => {
        if (window.blazorReconnection.isReconnecting) {
            console.log('Back online, attempting reconnection...');
            window.blazorReconnection.updateReconnectMessage('Back online. Reconnecting...');
        }
    });

    window.addEventListener('offline', () => {
        console.log('Gone offline');
        if (window.blazorReconnection.isReconnecting) {
            window.blazorReconnection.updateReconnectMessage('No internet connection. Waiting...');
        }
    });
</script>
</html>