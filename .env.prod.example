# Copy to .env.prod on the droplet and fill in real values (or let
# scripts/deploy-do.sh generate it from Doppler — see DOPPLER_CONFIG below).
# Never commit the filled-in .env.prod file.
#
# Keys use the same ASP.NET Core double-underscore convention as the Azure
# deploy (CLAUDE.md), so they're the exact names stored in Doppler's prd
# config and deploy-do.sh can just download the config verbatim.

# Domain pointed at the droplet's IP (A record). Required — Caddy uses this
# for the HTTPS cert, and BASEURL below must match it.
DOMAIN=beatballot.com
BASEURL=https://beatballot.com

# Used both by the postgres container itself and inside CONNECTIONSTRINGS__POSTGRES.
POSTGRES_PASSWORD=change-me
CONNECTIONSTRINGS__POSTGRES=Host=postgres;Port=5432;Database=beatballot;Username=beatballot;Password=change-me

SPOTIFY__CLIENTID=
SPOTIFY__CLIENTSECRET=

ADMINSETTINGS__PASSWORD=change-me

STRIPE__PUBLISHABLEKEY=pk_test_placeholder
STRIPE__SECRETKEY=sk_test_placeholder
STRIPE__WEBHOOKSECRET=whsec_placeholder
